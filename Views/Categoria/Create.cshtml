@model TiendavirtualArepasSafaera.Models.Categoria

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-warning text-dark text-center py-3 rounded-top-4">
                    <h3 class="mb-0 fw-bold">Crear Nueva Categoría</h3>
                </div>
                <div class="card-body p-4">

                    
                    <form asp-action="Create" asp-controller="Categoria" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold">Nombre de la Categoría</label>
                            <input asp-for="Nombre" class="form-control rounded-pill" placeholder="Ej: Salchipapas" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label fw-bold">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control rounded-4" rows="4" placeholder="Describe brevemente esta categoría..."></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end border-top pt-3">
                            <a href="/Categoria" class="btn btn-outline-secondary px-4 rounded-pill">Volver</a>
                            <button type="submit" class="btn btn-warning px-5 rounded-pill shadow-sm">Guardar Categoría</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}