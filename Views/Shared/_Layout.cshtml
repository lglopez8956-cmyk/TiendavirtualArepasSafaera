@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Arepas Safaera</title>
    <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <style>
                :root {
                        --street-black: #0d0d0d;
                        --chrome-silver: #a0a0a0;
                        --paper-white: #f4f4f4;

        }

                body {
                        background-color: var(--paper-white) !important;
                        font-family: 'Poppins', sans-serif;

        }

                .navbar {
                        background: var(--street-black) !important;
                        border-bottom: 4px solid var(--chrome-silver) !important;
            padding: 1rem 0; /* Un poco más de aire */

        }

                .safaera-brand {
                        font-family: 'Bangers', cursive;
                        font-size: 2rem !important;
                        letter-spacing: 3px;
                        color: var(--paper-white) !important;
                        text-shadow: 3px 3px 0px var(--chrome-silver), 5px 5px 0px #000;
            display: flex;
            align-items: center;
            gap: 10px;

        }

                .btn-logout {
                        border: 2px solid var(--chrome-silver) !important;
                        color: var(--chrome-silver) !important;
                        font-weight: bold;
                        text-transform: uppercase;

        }

                    .btn-logout:hover {
                            background: var(--chrome-silver) !important;
                            color: var(--street-black) !important;

        }


    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark mb-3">
            <div class="container">
                <a class="navbar-brand safaera-brand" href="/">
                    Arepas Safaera
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end align-items-center">
                    @if (Context.Session.GetString("Usuario") != null)
                    {
                        <ul class="navbar-nav align-items-center gap-3">
                            <li class="nav-item text-light">
                                👋 @Context.Session.GetString("Usuario") <small class="text-white-50">(@Context.Session.GetString("Rol"))</small>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-logout rounded-pill px-4 py-2" href="/Login/Logout">Salir</a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-logout rounded-pill px-4 py-2" href="/Usuario/Create">Registrarse</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 pb-5 mb-3">
        <div class="container">@RenderBody()</div>
    </main>

    <footer class="border-top footer text-center py-2 bg-dark text-white-50" style="position: fixed; bottom: 0; width: 100%; z-index: 1000;">
        <div class="container">&copy; 2026 - Arepas Safaera - Facultad de Ingeniería</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* SOLUCIÓN: Cambiamos 'required: true' por 'required: false' *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>