@model TiendavirtualArepasSafaera.Models.Usuario

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-success text-white text-center py-3 rounded-top-4">
                    <h3 class="mb-0 fw-bold">Crear Usuario</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold">Nombre</label>
                            <input asp-for="Nombre" class="form-control rounded-pill" placeholder="Nombre completo" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Correo" class="form-label fw-bold">Correo</label>
                                <input asp-for="Correo" class="form-control rounded-pill" placeholder="usuario@correo.com" />
                                <span asp-validation-for="Correo" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Celular" class="form-label fw-bold">Celular</label>
                                <input asp-for="Celular" class="form-control rounded-pill" placeholder="Ej: 310..." />
                                <span asp-validation-for="Celular" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Rol" class="form-label fw-bold">Rol</label>
                            <select asp-for="Rol" class="form-select rounded-pill">
                                <option value="Administrador">Administrador</option>
                                <option value="Cliente">Cliente</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Clave" class="form-label fw-bold">Clave</label>
                            <input asp-for="Clave" type="password" class="form-control rounded-pill" placeholder="********" />
                            <span asp-validation-for="Clave" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end border-top pt-3">
                            <a href="/Usuario" class="btn btn-outline-secondary px-4 rounded-pill">Volver</a>
                            <button type="submit" class="btn btn-success px-5 rounded-pill shadow-sm fw-bold">Guardar Usuario</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}