@model List<TiendavirtualArepasSafaera.Models.Usuario>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-people-fill text-success"></i> Lista de Usuarios</h2>

    <div>
        @* Botón de Volver al Home *@
        <a class="btn btn-outline-secondary rounded-pill px-4 shadow-sm me-2" href="/Home">
            <i class="bi bi-house"></i> Volver
        </a>

        @* Botón de Nuevo Usuario *@
        <a class="btn btn-success rounded-pill px-4 shadow-sm" href="/Usuario/Create">
            <i class="bi bi-plus-lg"></i> Nuevo Usuario
        </a>
    </div>
</div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Nombre</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Celular</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.Nombre</td>
                                <td>@item.Correo</td>
                                <td>
                                    <span class="badge rounded-pill bg-success bg-opacity-75">@item.Rol</span>
                                </td>
                                <td>@item.Celular</td>
                                <td class="text-center">
                                    <a class="btn btn-sm btn-warning rounded-pill px-3 mx-1 text-white shadow-sm" href="/Usuario/Edit/@item.Id">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <a class="btn btn-sm btn-danger rounded-pill px-3 mx-1 shadow-sm" href="/Usuario/Delete/@item.Id" onclick="return confirm('¿Seguro que deseas eliminar este usuario?');">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>