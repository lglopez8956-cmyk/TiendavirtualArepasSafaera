@model List<TiendavirtualArepasSafaera.Models.Producto>
@using Microsoft.AspNetCore.Http
<div class="container mt-4">

    <div class="mb-3">
        <a class="btn btn-outline-secondary" href="/Home/Index">← Volver al Inicio</a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <h2 class="mb-4 text-center">Productos</h2>

    <!-- ✅ BOTONES MEJORADOS -->
    <div class="mb-3 d-flex gap-2">
        @if (Context.Session.GetString("Rol") == "Administrador")
        {
            <a class="btn btn-warning fw-bold rounded-pill px-4" href="/Producto/Create">+ Nuevo Producto</a>
        }
        <a class="btn btn-dark fw-bold rounded-pill px-4 border border-warning text-warning" href="/Producto/Carrito">🛒 Ver Carrito</a>
    </div>

    <!-- ✅ FILTROS MEJORADOS -->
    <div class="mb-4 p-3 rounded-4 bg-white border d-flex flex-wrap gap-2 filtros-categoria">
        <button class="btn btn-warning btn-sm rounded-pill px-4 fw-bold" onclick="filtrarCategoria('todos', this)">🍽️ Todos</button>
        @foreach (var cat in Model.Where(p => p.Categoria != null).Select(p => p.Categoria).DistinctBy(c => c.Id))
        {
            <button class="btn btn-outline-dark btn-sm rounded-pill px-4 fw-bold text-dark" onclick="filtrarCategoria('@cat.Id', this)">@cat.Nombre</button>
        }
    </div>

    <div class="row" id="lista-productos">
        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-4 producto-card" data-categoria="@item.CategoriaId">
                <div class="card h-100 shadow">
                    <img src="@item.ImagenUrl" class="card-img-top" style="height:200px; object-fit:cover;" />
                    <div class="card-body">
                        <h5 class="card-title">@item.Nombre</h5>
                        <p class="card-text">
                            Precio: $@item.Precio <br />
                            Stock: @item.Stock <br />
                            Categoría: @item.Categoria?.Nombre
                        </p>
                        @if (Context.Session.GetString("Rol") == "Administrador")
                        {
                            <a href="/Producto/Edit/@item.Id" class="btn btn-warning btn-sm">Editar</a>
                            <a href="/Producto/Delete/@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                            <hr />
                        }
                        @if (item.Stock > 0)
                        {
                            <form asp-action="AgregarCarrito" method="post">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="number" name="cantidad" value="1" min="1" max="@item.Stock" class="form-control mb-2" />
                                <button class="btn btn-primary w-100" type="submit">Agregar al carrito</button>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-warning text-center">Producto agotado</div>
                            <button class="btn btn-secondary w-100" disabled>Sin stock</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<style>
    .filtros-categoria .btn-outline-dark:hover {
        background-color: #ffc107 !important;
        border-color: #ffc107 !important;
        color: #000 !important;
    }
</style>

<script>
    function filtrarCategoria(categoriaId, boton) {
        document.querySelectorAll('.filtros-categoria .btn').forEach(b => {
            b.classList.remove('btn-warning', 'text-dark');
            b.classList.add('btn-outline-dark', 'text-dark');
        });
        boton.classList.remove('btn-outline-dark');
        boton.classList.add('btn-warning', 'text-dark');

        document.querySelectorAll('.producto-card').forEach(card => {
            if (categoriaId === 'todos' || card.dataset.categoria === categoriaId) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>