@model TiendavirtualArepasSafaera.Models.Producto
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h3 class="mb-0">Crear Nuevo Producto</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" asp-controller="Producto" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombre" class="form-label fw-bold">Nombre</label>
                                <input asp-for="Nombre" class="form-control rounded-pill" placeholder="Ej: Arepa de Choclo" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="Precio" class="form-label fw-bold">Precio</label>
                                <input asp-for="Precio" class="form-control rounded-pill" type="number" step="0.01" />
                                <span asp-validation-for="Precio" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="Stock" class="form-label fw-bold">Stock</label>
                                <input asp-for="Stock" class="form-control rounded-pill" type="number" />
                                <span asp-validation-for="Stock" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="CategoriaId" class="form-label fw-bold">Categoría</label>
                            <select asp-for="CategoriaId" class="form-select rounded-pill">
                                <option value="">-- Seleccione una categoría --</option>
                                @foreach (var cat in ViewBag.Categorias)
                                {
                                    <option value="@cat.Id">@cat.Nombre</option>
                                }
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger"></span>
                        </div>

                        <!-- ✅ AGREGADO - campo Descripcion -->
                      
                        <div class="mb-4">
                            <label class="form-label fw-bold">Imagen del Producto</label>
                            <input type="file" name="imagen" class="form-control rounded-pill" accept="image/*" />
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="/Producto" class="btn btn-secondary px-4 rounded-pill">Volver</a>
                            <button type="submit" class="btn btn-success px-4 rounded-pill">Guardar Producto</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}